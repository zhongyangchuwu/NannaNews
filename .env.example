# Native use: leave NANNA_DATA_DIR empty to use $XDG_DATA_HOME/nannanews.
# Compose ignores this native setting: .env.active owns its image and data root.
NANNA_DATA_DIR=
NANNA_HOST=127.0.0.1
NANNA_PORT=8080
NANNA_BIND_ADDRESS=127.0.0.1
NANNA_SITE_NAME=公共消息
NANNA_PUBLIC_URL=http://127.0.0.1:8080
# Blank creates a private session.key inside NANNA_DATA_DIR; never commit it.
NANNA_SECRET_KEY=
NANNA_SESSION_COOKIE_SECURE=false
NANNA_QQ_GROUP_URL=
NANNA_QQ_GROUP_LABEL=订阅
NANNA_TYPST_BINARY=typst
NANNA_TYPST_PACKAGE_CACHE=
NANNA_TYPST_FONT_DIR=
NANNA_PDF_PARSER_BINARY=lit
# Configure an operator-owned model endpoint only when extraction is authorized.
NANNA_MODEL_BASE_URL=
NANNA_MODEL_API_KEY=
NANNA_MODEL_NAME=gpt-6-luna
NANNA_MODEL_TIMEOUT=90
NANNA_MODEL_API_STYLE=responses
# Collection stays off until the operator explicitly enables the worker.
NANNA_COLLECTION_ENABLED=false
NANNA_COLLECTION_TIME=04:00
NANNA_COLLECTION_PAGE_LIMIT=10
NANNA_COLLECTION_FETCH_WORKERS=1
# Optional console evidence: private foundation root containing foundation.sqlite3.
# Reads query SQLite directly; they never generate caches, migrate, back up or fetch missing files.
NANNA_READER_EVIDENCE_DIR=
# Local review Compose: container path under its private /data mount, not a host path.
# Leave empty until the foundation and its registered local files exist in the container.
NANNA_REVIEW_EVIDENCE_DIR=
# Compose-only: an existing Docker volume and private target-host backup directory.
# Create the volume explicitly; never point a fresh deployment at production data.
NANNA_DATA_VOLUME=nannanews_nanna-data
NANNA_BACKUP_DIR=
# Keep operator settings/secrets here. Create .env.active separately (see operations):
# NANNA_ACTIVE_IMAGE=<your-registry/image:version>
# NANNA_ACTIVE_DATA_DIR=/data/live
# Lifecycle scripts atomically update only .env.active after Web is healthy.
