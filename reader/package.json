{
  "name": "nanna-static-reader",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run stage:data -- --if-missing && npm run build:search && npm run build:public && vite --host 127.0.0.1",
    "stage:data": "node scripts/stage-data.mjs",
    "build:search": "node scripts/build-search.mjs",
    "build:public": "node scripts/build-public.mjs",
    "build:share": "node scripts/build-share.mjs",
    "check": "tsc -b",
    "build": "npm run stage:data -- --if-missing && npm run build:search && npm run build:public && npm run check && vite build && npm run build:share",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
