# Only reviewed code and package resources enter the build context.
# In particular, no host node_modules, public exports, archives or private state.
**
!pyproject.toml
!README.md
!LICENSE
!src/
!src/nannanews/
!src/nannanews/*.py
!src/nannanews/*.typ
!src/nannanews/web/
!src/nannanews/web/*.py
!src/nannanews/templates/
!src/nannanews/templates/*.html
!src/nannanews/static/
!src/nannanews/static/*.css
!src/nannanews/static/*.js
!src/nannanews/static/favicon.ico
!src/nannanews/data/
!src/nannanews/data/source_catalog.json
!src/nannanews/data/automation_sources.json
!reader/
!reader/package.json
!reader/package-lock.json
!reader/index.html
!reader/tsconfig.json
!reader/vite.config.ts
!reader/src/
!reader/src/**
!reader/scripts/
!reader/scripts/*.mjs
!deploy/
!deploy/Dockerfile
!deploy/stage-reader.sh
**/node_modules
**/__pycache__
**/*.key
**/*.pem
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/.env
**/.env.*
